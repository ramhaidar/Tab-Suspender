{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!build_dir",
			"!!node_modules",
			"!!**/package-lock.json",
			"!!**/pnpm-lock.yaml",
			"!!uninstall-survey",
			"!!lib",
			"!!popup.css",
			"!!*.min.js"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 140
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	}
}
