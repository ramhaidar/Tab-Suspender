{
	"name": "tab-suspender",
	"version": "1.0.0",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"scripts": {
		"watch": "node ./clean-build-dir.js && copy-files-from-to && tsc-watch --build ./ --onSuccess 'copy-files-from-to --silent'",
		"build": "node ./clean-build-dir.js && copy-files-from-to --silent && tsc --build ./",
		"copy-files-from-to": "copy-files-from-to",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit --pretty false",
		"typecheck:puppeteer": "tsc --project test/puppeteer/tsconfig.json --noEmit --pretty false",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run typecheck:puppeteer",
		"quality:check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:puppeteer && pnpm test && pnpm run build",
		"test": "jest --runInBand --forceExit --verbose",
		"testCacheCreate": "jest --cache --runInBand --silent"
	},
	"copyFiles": [
		{
			"from": [
				"./manifest.json",
				"./_locales/**",
				"./*.js",
				"./*.html",
				"./*.css",
				"./fancy-settings/**",
				"./modules/*.js",
				"./lib/**",
				"./img/**",
				"./video/**"
			],
			"to": "./build_dir/"
		}
	],
	"copyFilesSettings": {
		"whenFileExists": "overwrite"
	},
	"private": true,
	"dependencies": {
		"fake-indexeddb": "^6.0.0",
		"html-minifier": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/chrome": "0.0.271",
		"@types/jest": "^29.5.13",
		"@types/jquery": "1.10.45",
		"@types/node": "^18.19.74",
		"copy-files-from-to": "^3.11.0",
		"copyfiles": "^2.4.1",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"ts-jest": "^29.2.5",
		"ts-jest-mocker": "^1.0.0",
		"tsc-watch": "^5.0.3",
		"typescript": "^5.6.2"
	},
	"$schema": "https://json.schemastore.org/package"
}
